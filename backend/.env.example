# Local transcription model settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional local speaker diarization (accept community-1 model terms first)
HF_TOKEN=
PYANNOTE_METRICS_ENABLED=0
HF_HUB_DISABLE_TELEMETRY=1

# Supabase Data API credentials (server-side only; never put these in frontend/.env)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Groq Cloud analysis provider (free tier is subject to rate limits)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# Local data and privacy controls
MEETMIND_DATA_DIR=
MAX_RECORDING_MB=500
AUDIO_RETENTION_DAYS=30
KEEP_AUDIO=false

# Automatic pending-task email reminders (due date and daily while overdue)
# Example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true.
# Use your provider's app password where required; keep credentials private.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TASK_REMINDER_INTERVAL_SECONDS=3600

# Public landing page contact form. The form sends mail through the SMTP settings above.
CONTACT_EMAIL=riya.g290604@gmail.com

